# VoxFlow runs local-first by default.
# The Chrome extension connects to the local AI engine over localhost.
# No cloud API key is required for the MVP.

# Optional extension override:
# VOXFLOW_LOCAL_ENGINE_URL=ws://127.0.0.1:8765/ws

# Optional shared secret enforced by both /health and /ws.
# Configure the same value in the extension Options page.
# VOXFLOW_LOCAL_ENGINE_TOKEN=replace-with-a-long-random-token

# Browser Origin allowlist. Prefix wildcards are supported only at the end.
# CLI clients omit Origin and remain available for local diagnostics.
# VOXFLOW_ALLOWED_ORIGINS=chrome-extension://*,moz-extension://*
